<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SALFI S.A.S. - Banco Digital Familiar</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --azul-oscuro: #191970;
      --purpura-azulado: #483D8B;
      --azul-acero: #4682B4;
      --blanco: #ffffff;
      --gris-claro: #f8f9fa;
      --gris-medio: #6c757d;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 62.5%;
    }

    body {
      font-family: 'Inter', sans-serif;
      line-height: 1.6;
      color: var(--azul-oscuro);
      background-color: var(--blanco);
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Playfair Display', serif;
      margin-top: 0;
      color: var(--azul-oscuro);
    }

    a {
      text-decoration: none;
      color: inherit;
      transition: color 0.3s ease;
    }

    ul {
      list-style: none;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    /* Navbar */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(25, 25, 112, 0.95);
      backdrop-filter: blur(10px);
      padding: 1.5rem 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: padding 0.3s ease;
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 2.4rem;
      font-weight: 700;
      color: var(--blanco);
      letter-spacing: 0.5px;
    }

    .nav-links {
      display: flex;
      gap: 3rem;
    }

    .nav-links a {
      font-size: 1.6rem;
      font-weight: 500;
      color: var(--blanco);
      position: relative;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(135deg, var(--azul-acero), var(--purpura-azulado));
      transition-width: 0.3s;
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .cta-nav {
      background: linear-gradient(135deg, var(--azul-acero), var(--purpura-azulado));
      color: var(--blanco);
      padding: 0.8rem 2rem;
      border-radius: 4px;
      font-size: 1.6rem;
      font-weight: 600;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cta-nav:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(70, 130, 180, 0.4);
    }

    /* Mobile menu */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
    }

    .hamburger span {
      width: 25px;
      height: 3px;
      background: var(--blanco);
      transition: all 0.3s ease;
    }

    /* Hero Section */
    .hero {
      min-height: 100vh;
      background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--purpura-azulado) 100%);
      position: relative;
      display: flex;
      align-items: center;
      padding: 0 5%;
      margin-top: 8rem;
    }

    .hero-content {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
      color: var(--blanco);
    }

    .hero h1 {
      font-size: 4.5rem;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 2rem;
      letter-spacing: -1px;
    }

    .hero p {
      font-size: 1.8rem;
      margin-bottom: 3rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .btn-hero {
      display: inline-block;
      background: var(--azul-acero);
      color: var(--blanco);
      padding: 1.2rem 3rem;
      border-radius: 4px;
      font-size: 1.8rem;
      font-weight: 600;
      margin: 0 1rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .btn-hero:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(70, 130, 180, 0.4);
    }

    .btn-hero-secondary {
      background: transparent;
      border: 2px solid var(--blanco);
      color: var(--blanco);
      padding: 1.2rem 3rem;
      border-radius: 4px;
      font-size: 1.8rem;
      font-weight: 600;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .btn-hero-secondary:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }

    /* Visual elements hero */
    .hero-visual {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      text-align: left;
    }

    .phone-mockup {
      background: var(--blanco);
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      max-width: 350px;
      margin: 0 auto;
    }

    .card-digital {
      width: 60px;
      height: 35px;
      background: linear-gradient(135deg, var(--azul-acero), var(--purpura-azulado));
      border-radius: 6px;
      margin: 0.5rem auto;
    }

    /* Who We Are Section */
    .nosotros {
      padding: 8rem 5%;
      background-color: var(--gris-claro);
    }

    .nosotros h2 {
      font-size: 3.5rem;
      text-align: center;
      margin-bottom: 3rem;
      position: relative;
      display: inline-block;
    }

    .nosotros h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 4px;
      background: linear-gradient(135deg, var(--azul-acero), var(--purpura-azulado));
    }

    .conceptos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .concepto {
      padding: 2rem;
      background: var(--blanco);
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .concepto:hover {
      transform: translateY(-5px);
    }

    .concepto h3 {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: var(--azul-oscuro);
    }

    /* Services Section */
    .servicios {
      padding: 8rem 5%;
    }

    .servicios h2 {
      font-size: 3.5rem;
      text-align: center;
      margin-bottom: 5rem;
      position: relative;
      display: inline-block;
    }

    .servicios h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 4px;
      background: linear-gradient(135deg, var(--azul-acero), var(--purpura-azulado));
    }

    .servicios-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .servicio-card {
      padding: 2.5rem 2rem;
      background: var(--blanco);
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border-top: 4px solid var(--azul-oscuro);
    }

    .servicio-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .servicio-card:hover .servicio-icon {
      background: linear-gradient(135deg, var(--azul-acero), var(--purpura-azulado));
    }

    .servicio-icon {
      width: 60px;
      height: 60px;
      background: var(--gris-claro);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      transition: background 0.3s ease;
    }

    .servicio-icon svg {
      width: 30px;
      height: 30px;
      stroke: var(--azul-oscuro);
      fill: none;
      stroke-width: 1.5;
    }

    .servicio-icon path,
    .servicio-icon circle {
      stroke: var(--azul-oscuro);
    }

    .servicio-card h3 {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: var(--azul-oscuro);
    }

    .servicio-card p {
      font-size: 1.5rem;
      color: var(--gris-medio);
    }

    /* Generations Section */
    .generaciones {
      padding: 8rem 5%;
      background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--purpura-azulado) 100%);
      color: var(--blanco);
    }

    .generaciones h2 {
      font-size: 3.5rem;
      text-align: center;
      margin-bottom: 5rem;
      position: relative;
      display: inline-block;
    }

    .generaciones h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 4px;
      background: var(--azul-acero);
    }

    .generacion-card {
      padding: 3rem 2rem;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 15px;
      backdrop-filter: blur(10px);
      text-align: center;
      transition: transform 0.3s ease, background 0.3s ease;
    }

    .generacion-card:hover {
      transform: translateY(-10px);
      background: rgba(255, 255, 255, 0.2);
    }

    .generacion-card h3 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .generacion-card p {
      font-size: 1.6rem;
      opacity: 0.9;
    }

    .mascota {
      width: 80px;
      height: 80px;
      margin: 0 auto 2rem;
      background: var(--azul-acero);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      margin-bottom: 1.5rem;
    }

    /* Footer */
    footer {
      padding: 5rem 5% 2rem;
      background: var(--azul-oscuro);
      color: var(--blanco);
    }

    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .footer-brand p {
      font-size: 1.5rem;
      margin-top: 1rem;
      max-width: 200px;
    }

    .footer-links h4 {
      font-size: 1.8rem;
      margin-bottom: 2rem;
    }

    .footer-links ul li {
      margin-bottom: 1rem;
    }

    .footer-links a {
      font-size: 1.5rem;
      color: var(--blanco);
      opacity: 0.8;
      transition: opacity 0.3s ease;
    }

    .footer-links a:hover {
      opacity: 1;
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 0 auto;
      padding-top: 2rem;
      border-top: 1px solid var(--purpura-azulado);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1.4rem;
      color: var(--gris-medio);
    }

    /* Mobile Menu Active */
    .nav-active {
      display: block;
    }

    .toggle .line1 {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .toggle .line2 {
      opacity: 0;
    }

    .toggle .line3 {
      transform: rotate(-45deg) translate(7px, -6px);
    }

    @media (max-width: 900px) {
      .nav-links {
        position: fixed;
        top: 8rem;
        left: 0;
        right: 0;
        background: rgba(25, 25, 112, 0.98);
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding: 2rem 5%;
        display: none;
        width: 100%;
      }

      .hamburger {
        display: flex;
      }
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 3.5rem;
      }

      .hero p {
        font-size: 1.6rem;
      }

      .btn-hero {
        padding: 1rem 2rem;
        font-size: 1.6rem;
      }
    }
  </style>
</head>
